{
  "datasets": [
    {
      "name": "trips_data",
      "displayName": "Transportation Trips Data",
      "config": {
        "version": "1.1",
        "source": "transportation.gold.fact_trips",
        "dimensions": [
          {
            "name": "city_name",
            "expr": "CASE city_name\n  WHEN 'Jaipur' THEN 'West'\n  WHEN 'Surat' THEN 'Southwest'\n  WHEN 'Indore' THEN 'Midwest'\n  WHEN 'Coimbatore' THEN 'South'\n  WHEN 'Lucknow' THEN 'Northeast'\n  WHEN 'Kochi' THEN 'Southeast'\n  WHEN 'Visakhapatnam' THEN 'East'\n  WHEN 'Mysore' THEN 'Pacific'\n  WHEN 'Chandigarh' THEN 'Mid-Atlantic'\n  ELSE 'Central'\nEND"
          },
          {
            "name": "business_date",
            "expr": "business_date"
          },
          {
            "name": "passenger_category",
            "expr": "passenger_category"
          },
          {
            "name": "day_of_week",
            "expr": "day_of_week"
          },
          {
            "name": "month_year",
            "expr": "month_year"
          },
          {
            "name": "driver_rating",
            "expr": "driver_rating"
          },
          {
            "name": "passenger_rating",
            "expr": "passenger_rating"
          },
          {
            "name": "day_type",
            "expr": "CASE WHEN is_weekend THEN 'Weekend' ELSE 'Weekday' END"
          },
          {
            "name": "holiday_type",
            "expr": "CASE WHEN national_holiday THEN 'Holiday' ELSE 'Non-Holiday' END"
          }
        ],
        "measures": [
          {
            "name": "trip_count",
            "expr": "COUNT(*)"
          },
          {
            "name": "total_revenue",
            "expr": "SUM(sales_amt) * 0.012",
            "format": {
              "type": "currency",
              "currencyCode": "USD",
              "decimalPlaces": {
                "type": "exact",
                "places": 0.0
              }
            }
          },
          {
            "name": "avg_distance",
            "expr": "AVG(distance_kms) * 0.621371"
          },
          {
            "name": "avg_passenger_rating",
            "expr": "AVG(passenger_rating)"
          },
          {
            "name": "avg_driver_rating",
            "expr": "AVG(driver_rating)"
          },
          {
            "name": "avg_revenue",
            "expr": "AVG(sales_amt) * 0.012"
          }
        ]
      }
    },
    {
      "name": "top_cities",
      "displayName": "Top 10 Cities by Trip Count",
      "config": {
        "version": "1.1",
        "source": "SELECT\n  CASE city_name\n    WHEN 'Jaipur' THEN 'West'\n    WHEN 'Surat' THEN 'Southwest'\n    WHEN 'Indore' THEN 'Midwest'\n    WHEN 'Coimbatore' THEN 'South'\n    WHEN 'Lucknow' THEN 'Northeast'\n    WHEN 'Kochi' THEN 'Southeast'\n    WHEN 'Visakhapatnam' THEN 'East'\n    WHEN 'Mysore' THEN 'Pacific'\n    WHEN 'Chandigarh' THEN 'Mid-Atlantic'\n    ELSE 'Central'\n  END AS city_name,\n  COUNT(*) AS trip_count\nFROM transportation.gold.fact_trips\nGROUP BY\n  CASE city_name\n    WHEN 'Jaipur' THEN 'West'\n    WHEN 'Surat' THEN 'Southwest'\n    WHEN 'Indore' THEN 'Midwest'\n    WHEN 'Coimbatore' THEN 'South'\n    WHEN 'Lucknow' THEN 'Northeast'\n    WHEN 'Kochi' THEN 'Southeast'\n    WHEN 'Visakhapatnam' THEN 'East'\n    WHEN 'Mysore' THEN 'Pacific'\n    WHEN 'Chandigarh' THEN 'Mid-Atlantic'\n    ELSE 'Central'\n  END\nORDER BY trip_count DESC\nLIMIT 10",
        "dimensions": [
          {
            "name": "city_name",
            "expr": "city_name"
          }
        ],
        "measures": [
          {
            "name": "trip_count",
            "expr": "SUM(trip_count)"
          }
        ]
      }
    },
    {
      "name": "dim_city",
      "displayName": "City Dimension",
      "config": {
        "version": "1.1",
        "source": "transportation.silver.city",
        "dimensions": [
          {
            "name": "city_id",
            "expr": "city_id"
          },
          {
            "name": "city_name",
            "expr": "CASE city_name\n  WHEN 'Jaipur' THEN 'West'\n  WHEN 'Surat' THEN 'Southwest'\n  WHEN 'Indore' THEN 'Midwest'\n  WHEN 'Coimbatore' THEN 'South'\n  WHEN 'Lucknow' THEN 'Northeast'\n  WHEN 'Kochi' THEN 'Southeast'\n  WHEN 'Visakhapatnam' THEN 'East'\n  WHEN 'Mysore' THEN 'Pacific'\n  WHEN 'Chandigarh' THEN 'Mid-Atlantic'\n  ELSE 'Central'\nEND"
          }
        ]
      }
    },
    {
      "name": "dim_calendar",
      "displayName": "Calendar Dimension",
      "config": {
        "version": "1.1",
        "source": "transportation.silver.calendar",
        "dimensions": [
          {
            "name": "date",
            "expr": "date"
          },
          {
            "name": "holiday_name",
            "expr": "holiday_name"
          },
          {
            "name": "is_holiday",
            "expr": "is_holiday"
          },
          {
            "name": "day_of_week_abbr",
            "expr": "day_of_week_abbr"
          },
          {
            "name": "month_name",
            "expr": "month_name"
          },
          {
            "name": "quarter",
            "expr": "quarter"
          },
          {
            "name": "year",
            "expr": "year"
          }
        ]
      }
    }
  ],
  "relationshipGraphs": [
    {
      "sources": [
        {
          "name": "Transportation_Trips_Data",
          "datasetName": "trips_data"
        },
        {
          "name": "Top_10_Cities_by_Trip_Count",
          "datasetName": "top_cities"
        },
        {
          "name": "City_Dimension",
          "datasetName": "dim_city"
        },
        {
          "name": "Calendar_Dimension",
          "datasetName": "dim_calendar"
        }
      ],
      "relationships": [
        {
          "name": "relationship_0",
          "from": "Transportation_Trips_Data",
          "to": "Calendar_Dimension",
          "on": "`Transportation_Trips_Data`.`business_date` = `Calendar_Dimension`.`date`",
          "cardinality": "CARDINALITY_MANY_TO_ONE"
        },
        {
          "name": "relationship_1",
          "from": "Transportation_Trips_Data",
          "to": "City_Dimension",
          "on": "`Transportation_Trips_Data`.`city_id` = `City_Dimension`.`city_id`",
          "cardinality": "CARDINALITY_MANY_TO_ONE"
        }
      ],
      "measureExpressions": [
        {
          "name": "revenue_per_holiday",
          "expression": "MEASURE(`Transportation_Trips_Data`.`total_revenue`) / COUNT(`Calendar_Dimension`.`date`)"
        },
        {
          "name": "trips_per_holiday",
          "expression": "MEASURE(`Transportation_Trips_Data`.`trip_count`) / COUNT(`Calendar_Dimension`.`date`)"
        }
      ]
    }
  ],
